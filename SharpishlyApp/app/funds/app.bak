const app = {};

app.menus = [{key:'home',value:'Home'},{key:'about',value:'About'}];

app.fields = [{key:'full_name',value:'Full Name',attr:{foo:'bar'}},{key:'email',value:'Email',attr:{foo:'bar'}}];


app.addFormInput = function(section,i){

    if (typeof i !== 'undefined') {
        // prettyBug('i exists and has a value');
        field = app.fields[i];
        // prettyBug(field['value']);
        const div = document.createElement('div');
        section.appendChild(div);

        const label = document.createElement('label');
        label.innerHTML=field['value'];
        label.setAttribute('for',field['key']);
        section.appendChild(label);

        const input = document.createElement('input');
        input.setAttribute('type','text');
        input.setAttribute('required','required');
        section.appendChild(input);

        const span = document.createElement('span');
        span.setAttribute('class','error');
        section.appendChild(span);
    } else {
        // prettyBug('i is not declared');
    }    
};

app.addForm = function(){
    const container = document.getElementById('main');
    const form = document.createElement('form');
    const section = document.createElement('section');
    const h2 = document.createElement('h2');

    h2.innerHTML="Funding your dreams"; 
    section.appendChild(h2);

    app.addFormInput(section);

    for(i=0; i<app.fields.length; i++){

        app.addFormInput(section,i);

    }

    form.appendChild(section);

    container.appendChild(form);
}

app.addMainMenu = function() {
    const container = document.getElementById('container');
    const ul = document.createElement('ul');
    
    for(i=0; i<app.menus.length; i++){

        const li = document.createElement('li');
        li.innerHTML = app.menus[i].value;
        li.onclick = function(){
            alert('test');
        };
        ul.appendChild(li);
        container.appendChild(ul);

    }
    
};

app.addMaintitle = function() {
    const container = document.getElementById('container');
    const h1 = document.createElement('h1');
    h1.textContent = 'The cat that funds your dreams 🐱💰';
    container.appendChild(h1);
};

app.addSubtitle = function() {
    const container = document.getElementById('container');
    const h2 = document.createElement('h2');
    h2.textContent = 'The cat that funds your dreams 🐱💰';
    container.appendChild(h2);
};

app.run = function() {
    app.addMainMenu();
    app.addMaintitle();
    app.addSubtitle();
    app.addForm();
    prettyBug(app);
};

// Correct way:
window.onload = app.run;
